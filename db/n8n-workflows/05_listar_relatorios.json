    {
      "id": "pg_listar",
      "name": "Listar Relatorios",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [260, 300],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "SELECT\n  r.id,\n  r.tipo::text AS tipo,\n  r.paciente_id,\n  p.nome_completo AS paciente_nome,\n  r.atendimento_id,\n  r.autor_id,\n  au.nome AS autor_nome,\n  r.data,\n  r.conteudo,\n  r.editado_por_id,\n  ed.nome AS editado_por_nome\nFROM relatorios r\nJOIN pacientes p ON p.id = r.paciente_id\nJOIN usuarios au ON au.id = r.autor_id\nLEFT JOIN usuarios ed ON ed.id = r.editado_por_id\nORDER BY r.data DESC, r.id DESC",
        "options": {}
      },
      "credentials": {
        "postgres": { "id": "eqtrPgCredential01", "name": "Equitar Postgres" }
      }
    },
    {
      "id": "respond1",
      "name": "Responder Lista",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [520, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $input.all().map(item => item.json) }}",
        "options": { "responseCode": 200 }
      }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Listar Relatorios", "type": "main", "index": 0 }]] },
    "Listar Relatorios": { "main": [[{ "node": "Responder Lista", "type": "main", "index": 0 }]] }
  }
