{
  "id": "eqtr05ListarRelatorios",
  "name": "Equitar - GET /listar/relatorios",
  "active": true,
  "nodes": [
    {
      "id": "webhook1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "webhookId": "b1a1c1d1-0005-4000-8000-000000000001",
      "position": [0, 300],
      "parameters": {
        "httpMethod": "GET",
        "path": "listar/relatorios",
        "responseMode": "responseNode",
        "options": {}
      }
